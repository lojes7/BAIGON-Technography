# ==========================================
# 环境变量配置
# ==========================================

# -------------------- 基础设施 --------------------
# PostgreSQL
POSTGRES_VERSION=16
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=postgres

# Consul
CONSUL_VERSION=1.19
CONSUL_PORT=8500

# Kafka
KAFKA_PORT=9092
# KRaft 集群 ID 必须固定，不能在重建容器时重新生成
KAFKA_CLUSTER_ID=FLtTK3tyTua9kG01_XmVPw

# MinIO (对象存储)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=12345678

# -------------------- 各服务数据库 --------------------
# crawler_service (Python)
CRAWLER_DB_NAME=baigon_crawler
CRAWLER_DB_USER=crawler_service
CRAWLER_DB_PASSWORD=123456

# ai_service (Python) — 不需要独立数据库，但保留配置
AI_DB_NAME=baigon_ai
AI_DB_USER=ai_service
AI_DB_PASSWORD=123456

# occupation_service (Java)
OCCUPATION_DB_NAME=baigon_occupation
OCCUPATION_DB_USER=occupation_service
OCCUPATION_DB_PASSWORD=123456

# user_service (Java)
USER_DB_NAME=baigon_user
USER_DB_USER=user_service
USER_DB_PASSWORD=123456

# -------------------- 服务端口 --------------------
FRONTEND_PORT=3000

GATEWAY_PORT=8000
GATEWAY_GRPC_PORT=9099

CRAWLER_GRPC_PORT=50011
AI_GRPC_PORT=50013
OCCUPATION_GRPC_PORT=50014
USER_GRPC_PORT=50015

# -------------------- 安全 --------------------
JWT_SECRET='you-secret-key'
JWT_EXPIRATION_HOURS=1

# -------------------- LLM --------------------

# 讯飞星火 OpenAI 兼容接口（服务实际使用）
SPARK_API_PASSWORD= 

# 阿里云百炼 OpenAI 兼容文本嵌入接口
DASHSCOPE_API_KEY = 

# -------------------- 雪花 ID worker 分配
SNOWFLAKE_WORKER_ID_GATEWAY=1
SNOWFLAKE_WORKER_ID_USER=2
SNOWFLAKE_WORKER_ID_CRAWLER=3
SNOWFLAKE_WORKER_ID_OCCUPATION=4
